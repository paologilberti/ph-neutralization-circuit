.model FSMD_non_ottimizzata

.inputs RST START PH7 PH6 PH5 PH4 PH3 PH2 PH1 PH0
.outputs FINE_OPERAZIONE ERRORE_SENSORE VALVOLA_ACIDO VALVOLA_BASICO PH_FINALE7 PH_FINALE6 PH_FINALE5 PH_FINALE4 PH_FINALE3 PH_FINALE2 PH_FINALE1 PH_FINALE0 NCLK7 NCLK6 NCLK5 NCLK4 NCLK3 NCLK2 NCLK1 NCLK0

.subckt fsm_ottimizzata RST=RST START=START PH7=PH7 PH6=PH6 PH5=PH5 PH4=PH4 PH3=PH3 PH2=PH2 PH1=PH1 PH0=PH0 FINE=XX FINE_OP=FINE_OPERAZIONE ERRORE=ERRORE_SENSORE VALV_ACIDA=VALVOLA_ACIDO VALV_BASICA=VALVOLA_BASICO INIZIO=Y TIPO1=T1 TIPO0=T0
.subckt dp_ottimizzato INIZIO=Y PH7=PH7 PH6=PH6 PH5=PH5 PH4=PH4 PH3=PH3 PH2=PH2 PH1=PH1 PH0=PH0 TIPO1=T1 TIPO0=T0 RESET=RST PHF7=PH_FINALE7 PHF6=PH_FINALE6 PHF5=PH_FINALE5 PHF4=PH_FINALE4 PHF3=PH_FINALE3 PHF2=PH_FINALE2 PHF1=PH_FINALE1 PHF0=PH_FINALE0 NC7=NCLK7 NC6=NCLK6 NC5=NCLK5 NC4=NCLK4 NC3=NCLK3 NC2=NCLK2 NC1=NCLK1 NC0=NCLK0 QFF=XX

.end

.search fsm_ottimizzata.blif
.search dp_ottimizzato.blif

.end
